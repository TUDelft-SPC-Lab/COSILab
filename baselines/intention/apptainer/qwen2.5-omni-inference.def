Bootstrap: docker
From: nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

%labels
    Author zonghuan
    Description "Qwen2.5-Omni inference with chunked vision SDPA (Transformers 4.54)"

%help
    Qwen2.5-Omni inference image for the COSILab intention baseline.

    Transformers 4.54 is intentional: compared with 4.52.3, its Qwen2.5-Omni
    vision SDPA path attends to the cu_seqlens chunks separately instead of
    materialising attention over the combined visual sequence.

    Build a new image rather than overwriting the currently deployed one:

      apptainer build qwen2.5-omni-inference-tf4.54.sif \
        baselines/intention/apptainer/qwen2.5-omni-inference.def

    Check the installed stack:

      apptainer exec --nv qwen2.5-omni-inference-tf4.54.sif python -V

    Validate the memory curve on a GPU node before changing model_backends.sh:

      sbatch baselines/intention/apptainer/probe_qwen25_vision_daic.sh \
        --sif-path /path/to/qwen2.5-omni-inference-tf4.54.sif \
        --video /path/to/a/representative/clip.mp4

    This image deliberately does not install external flash-attn. Qwen uses
    attn_implementation=sdpa, dispatched by the CUDA 12.8 PyTorch build.

%environment
    export LC_ALL=C
    export LANG=C
    export PYTHONUNBUFFERED=1
    export HF_HOME=${HF_HOME:-/opt/huggingface}
    export TRANSFORMERS_CACHE=${TRANSFORMERS_CACHE:-$HF_HOME}
    export HF_HUB_ENABLE_HF_TRANSFER=1

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        ffmpeg \
        git \
        git-lfs \
        libsndfile1 \
        python3 \
        python3-dev \
        python3-pip \
        python-is-python3
    rm -rf /var/lib/apt/lists/*

    git lfs install
    python -m pip install --no-cache-dir --upgrade pip setuptools wheel

    # PyTorch 2.7.1's CUDA 12.8 wheels support Blackwell (sm_120) and provide
    # the native SDPA kernels used by the model. Install the matched trio from
    # one index so pip cannot mix CUDA variants.
    python -m pip install --no-cache-dir networkx==3.1
    python -m pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cu128 \
        torch==2.7.1 \
        torchvision==0.22.1 \
        torchaudio==2.7.1

    # 4.54.0 is the first Transformers release with the Qwen2.5-Omni vision
    # chunking fix. Pin the surrounding inference stack as well: a rebuilt SIF
    # should not silently acquire different preprocessing or device placement.
    python -m pip install --no-cache-dir \
        accelerate==1.9.0 \
        av==14.2.0 \
        "qwen-omni-utils[decord]==0.0.8" \
        soundfile==0.13.1 \
        transformers==4.54.0 \
        hf-transfer==0.1.9

    mkdir -p /opt/huggingface

%runscript
    exec python "$@"

%test
    python - <<'PY'
import accelerate
import av
import decord
import qwen_omni_utils
import torch
import transformers
from importlib.metadata import version
from transformers import Qwen2_5OmniForConditionalGeneration, Qwen2_5OmniProcessor

assert transformers.__version__ == "4.54.0", transformers.__version__
assert torch.__version__.startswith("2.7.1"), torch.__version__

print("torch:", torch.__version__)
print("transformers:", transformers.__version__)
print("accelerate:", accelerate.__version__)
print("av:", av.__version__)
print("decord:", version("decord"))
print("qwen-omni-utils:", version("qwen-omni-utils"))
print("qwen_omni_utils:", qwen_omni_utils.__file__)
print("Qwen2.5-Omni model and processor imports succeeded")
PY
